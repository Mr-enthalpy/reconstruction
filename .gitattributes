# Recorded measurement artifacts are compared by SHA256 against the file that was
# produced on the acquisition host. Keep them byte-exact: no line-ending rewrite on
# checkout, so `git show HEAD:<path> | sha256sum` matches the recorded digest on any
# platform.
docs/reports/*/runs/**/validation.json -text
docs/reports/*/*_validation.json -text
# D5.4 evidence/provenance JSONs retain the bytes used by their recorded hashes.
docs/reports/2026-10-30-d5.4/*.json -text
